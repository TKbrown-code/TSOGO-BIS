# ============================================
# TSOGO-BIS Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://gidifmqzolmrqpywpimw.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# Webhook Secret for Payment Processing
# This should match your CamPay webhook configuration
VITE_X_WEBHOOK_SECRET=your_webhook_secret_here

# CamPay API Endpoint (Optional - uses default if not set)
# Only change this if you're using a different Supabase project for Edge Functions
VITE_CAMPAY_API_URL=https://ebnjqpqegwmbalufhpqk.supabase.co/functions/v1/create-campay-order

# ============================================
# PRODUCTION DEPLOYMENT NOTES:
# ============================================
# 1. Set these variables in your hosting platform (Vercel, Netlify, etc.)
# 2. Never expose these values in client-side code
# 3. Use VITE_ prefix for variables accessible in the browser
# 4. Keep .env file in .gitignore (already configured)
# ============================================
