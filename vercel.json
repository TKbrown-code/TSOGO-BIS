{
  "rewrites": [
    { "source": "/shop", "destination": "/shop/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/logistics", "destination": "/logistics/index.html" },
    { "source": "/terms-and-policies", "destination": "/terms-and-policies/index.html" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/orders", "destination": "/orders/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/SignUp", "destination": "/SignUp/index.html" },
    { "source": "/reset-password", "destination": "/reset-password/index.html" },
    { "source": "/fapshi", "destination": "/fapshi/index.html" },
    { "source": "/track", "destination": "/track/index.html" },
    { "source": "/track/:trackingId", "destination": "/track/index.html" },
    { "source": "/ProductDetails/:id/:name", "destination": "/ProductDetails/:id/:name/index.html" },
    { "source": "/referrals/:encodedUserId/:userIdPrefix", "destination": "/referrals/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
